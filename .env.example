SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Optional order-status emails. Use a Resend API key and a verified sender address.
# Keep the key only in .env or deployment secrets; never commit it.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Pub Order <orders@your-verified-domain.example>

# Optional, for integration and full-stack E2E tests against a local Supabase
# (supabase start). Use the local values only; see README > Running tests.
# PUB_ORDER_TEST_EMAIL=test-user@example.com
# PUB_ORDER_TEST_PASSWORD=...
# PUB_ORDER_TEST_SERVICE_KEY=local-service-role-key
